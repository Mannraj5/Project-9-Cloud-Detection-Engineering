// Generated by `detlab convert` from rules/aws/aws_guardrail_policy_change.yml. Do not edit by hand.
from detlab-cloudtrail metadata _id, _index, _version | where eventSource=="organizations.amazonaws.com" and (eventName in ("CreatePolicy", "UpdatePolicy", "DeletePolicy", "AttachPolicy", "DetachPolicy", "EnablePolicyType", "DisablePolicyType")) or eventSource=="sso.amazonaws.com" and (eventName in ("CreatePermissionSet", "UpdatePermissionSet", "DeletePermissionSet", "PutInlinePolicyToPermissionSet", "DeleteInlinePolicyFromPermissionSet", "AttachManagedPolicyToPermissionSet", "DetachManagedPolicyFromPermissionSet", "AttachCustomerManagedPolicyReferenceToPermissionSet", "DetachCustomerManagedPolicyReferenceFromPermissionSet", "PutPermissionsBoundaryToPermissionSet", "DeletePermissionsBoundaryFromPermissionSet", "ProvisionPermissionSet", "CreateAccountAssignment", "DeleteAccountAssignment"))
