// Generated by `detlab convert` from rules/aws/aws_activity_outside_approved_region.yml. Do not edit by hand.
from detlab-cloudtrail metadata _id, _index, _version | where readOnly==false and not (awsRegion=="ap-southeast-2" or awsRegion=="us-east-1" and (eventSource in ("iam.amazonaws.com", "organizations.amazonaws.com", "signin.amazonaws.com", "sts.amazonaws.com", "account.amazonaws.com", "billingconsole.amazonaws.com", "budgets.amazonaws.com", "ce.amazonaws.com", "cur.amazonaws.com", "health.amazonaws.com", "support.amazonaws.com", "trustedadvisor.amazonaws.com", "cloudfront.amazonaws.com", "route53.amazonaws.com", "notifications.amazonaws.com")))
