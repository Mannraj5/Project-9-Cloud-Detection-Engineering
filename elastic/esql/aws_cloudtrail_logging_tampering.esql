// Generated by `detlab convert` from rules/aws/aws_cloudtrail_logging_tampering.yml. Do not edit by hand.
from detlab-cloudtrail metadata _id, _index, _version | where eventSource=="cloudtrail.amazonaws.com" and (eventName in ("StopLogging", "DeleteTrail", "UpdateTrail", "PutEventSelectors", "DeleteEventDataStore", "StopEventDataStoreIngestion")) and (userIdentity.invokedBy is null or userIdentity.sessionContext.sessionIssuer.userName is null or not (userIdentity.invokedBy=="cloudtrail.amazonaws.com" and userIdentity.sessionContext.sessionIssuer.userName=="AWSServiceRoleForCloudTrail"))
