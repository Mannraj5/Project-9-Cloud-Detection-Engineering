// Generated by `detlab convert` from rules/aws/aws_console_login_without_mfa.yml. Do not edit by hand.
from detlab-cloudtrail metadata _id, _index, _version | where eventSource=="signin.amazonaws.com" and eventName=="ConsoleLogin" and responseElements.ConsoleLogin=="Success" and additionalEventData.MFAUsed=="No" and (userIdentity.type in ("IAMUser", "Root"))
