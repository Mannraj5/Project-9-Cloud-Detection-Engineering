// Generated by `detlab convert` from rules/entra/entra_mass_user_disable.yml. Do not edit by hand.
from detlab-entra-audit metadata _id, _index, _version | where activityDisplayName=="Disable account" and result=="success"
| eval timebucket=date_trunc(10minutes, @timestamp) | stats event_count=count() by timebucket, initiatedBy.user.userPrincipalName
| where event_count >= 5
