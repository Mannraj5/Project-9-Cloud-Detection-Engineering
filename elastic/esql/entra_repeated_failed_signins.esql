// Generated by `detlab convert` from rules/entra/entra_repeated_failed_signins.yml. Do not edit by hand.
from detlab-entra-signin metadata _id, _index, _version | where status.errorCode in (50126, 50053)
| eval timebucket=date_trunc(10minutes, @timestamp) | stats event_count=count() by timebucket, detlab.user_principal_name_lc
| where event_count >= 10
