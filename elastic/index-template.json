{
  "index_patterns": ["detlab-*", "detlabtest-*"],
  "priority": 500,
  "_meta": {
    "description": "Project 9 detection lab. Every field used by a rule is mapped here explicitly; detlab lint checks this."
  },
  "template": {
    "settings": {
      "number_of_replicas": 0,
      "index.mapping.total_fields.limit": 3000,
      "index.mapping.ignore_malformed": true
    },
    "mappings": {
      "date_detection": false,
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 4096 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },

        "eventTime": { "type": "date" },
        "eventSource": { "type": "keyword" },
        "eventName": { "type": "keyword" },
        "awsRegion": { "type": "keyword" },
        "readOnly": { "type": "boolean" },
        "userIdentity": {
          "properties": {
            "type": { "type": "keyword" },
            "invokedBy": { "type": "keyword" },
            "sessionContext": {
              "properties": {
                "sessionIssuer": {
                  "properties": {
                    "userName": { "type": "keyword" }
                  }
                }
              }
            }
          }
        },
        "requestParameters": { "type": "object", "dynamic": false },
        "responseElements": {
          "type": "object",
          "dynamic": false,
          "properties": {
            "ConsoleLogin": { "type": "keyword" }
          }
        },
        "additionalEventData": {
          "type": "object",
          "dynamic": false,
          "properties": {
            "MFAUsed": { "type": "keyword" }
          }
        },
        "serviceEventDetails": { "type": "object", "dynamic": false },

        "createdDateTime": { "type": "date" },
        "status": {
          "properties": {
            "errorCode": { "type": "long" }
          }
        },

        "activityDateTime": { "type": "date" },
        "activityDisplayName": { "type": "keyword" },
        "result": { "type": "keyword" },
        "initiatedBy": {
          "properties": {
            "user": {
              "properties": {
                "userPrincipalName": { "type": "keyword" }
              }
            }
          }
        },

        "detlab": {
          "properties": {
            "source": { "type": "keyword" },
            "user_principal_name_lc": { "type": "keyword" },
            "modified": {
              "properties": {
                "Role_DisplayName": { "type": "keyword" }
              }
            }
          }
        }
      }
    }
  }
}
